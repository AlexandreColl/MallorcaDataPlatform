    {
      "id": 9,
      "type": "stat",
      "title": "Lluvia vs reservas en marzo",
      "description": "Correlación de Pearson entre la lluvia de septiembre a febrero y las reservas de marzo, año a año: cuánto explica la lluvia de otoño e invierno el agua con la que empieza la primavera.",
      "gridPos": {
        "h": 11,
        "w": 4,
        "x": 14,
        "y": 22
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH y AS (SELECT hydrological_year, max(rain_hydrological_year_mm) FILTER (WHERE extract(month FROM month) = 2) AS rain_winter, max(reserves_pct) FILTER (WHERE extract(month FROM month) = 3) AS reserves_march FROM gold.fct_resources_monthly GROUP BY 1) SELECT corr(rain_winter, reserves_march) AS \"Correlación\", count(*) FILTER (WHERE rain_winter IS NOT NULL AND reserves_march IS NOT NULL) AS \"Años\" FROM y"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Años"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
