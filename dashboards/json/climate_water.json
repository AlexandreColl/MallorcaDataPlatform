            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH m AS (SELECT a.aquifer, (o.ts AT TIME ZONE 'Europe/Madrid')::date AS month, o.value FROM gold.fct_observations o JOIN gold.dim_aquifers a ON a.entity = o.entity WHERE o.source = 'water_reserves'), last AS (SELECT max(month) AS month FROM m) SELECT m.aquifer AS \"Acuífero\", m.value AS \"%\", m.value - p.value AS \"12 meses (pts)\" FROM m JOIN last USING (month) LEFT JOIN m p ON p.aquifer = m.aquifer AND p.month = (m.month - interval '12 months')::date ORDER BY m.value"
        }
      ],
