    {
      "id": 8,
      "type": "table",
      "title": "Por año hidrológico",
      "description": "Septiembre a agosto: la lluvia que recarga los acuíferos, la temperatura y el calor, y las reservas al final del invierno (marzo) y del verano (agosto).",
      "gridPos": {
        "h": 11,
        "w": 14,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.hydrological_year::text AS \"Año hidrológico\", max(r.rain_hydrological_year_mm) FILTER (WHERE extract(month FROM r.month) = 8) AS \"Lluvia (mm)\", avg(r.temperature_mean_c) AS \"Temperatura media (°C)\", sum(r.hot_days) AS \"Días ≥ 30 °C\", max(r.reserves_pct) FILTER (WHERE extract(month FROM r.month) = 3) AS \"Reservas marzo (%)\", max(r.reserves_pct) FILTER (WHERE extract(month FROM r.month) = 8) AS \"Reservas agosto (%)\", count(r.temperature_mean_c) AS \"Meses\" FROM gold.fct_resources_monthly r WHERE r.hydrological_year >= 2017 GROUP BY r.hydrological_year ORDER BY r.hydrological_year DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "decimals": 0
        },
