    {
      "id": 5,
      "type": "geomap",
      "title": "Servicio por parada (último día)",
      "description": "Mancha de calor de los vehículos programados por parada el último día del rango: EMT Palma en la ciudad y CTM en toda la isla.",
      "gridPos": {
        "h": 14,
        "w": 16,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "D",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT l.lat, l.lon, a.avg_value AS buses FROM gold.agg_daily_metrics a JOIN gold.dim_locations l USING (source, entity) WHERE a.source IN ('emt_palma', 'ctm') AND a.metric = 'scheduled_departures' AND (a.source, a.local_date) IN (SELECT source, max(local_date) FROM gold.agg_daily_metrics WHERE source IN ('emt_palma', 'ctm') AND metric = 'scheduled_departures' AND local_date <= $__timeTo()::date GROUP BY source)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 39.62,
          "lon": 2.95,
          "zoom": 9
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OpenStreetMap",
          "config": {}
        },
        "tooltip": {
          "mode": "details"
        },
        "layers": [
          {
            "type": "heatmap",
            "name": "Servicio programado por parada (EMT Palma y CTM)",
            "tooltip": false,
            "filterData": {
              "id": "byRefId",
              "options": "D"
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "opacity": 0.55,
            "config": {
              "blur": 18,
              "radius": 6,
              "weight": {
                "field": "buses",
                "fixed": 1,
                "min": 0,
                "max": 1
              }
            }
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Paradas con más servicio (último día)",
      "description": "Las 20 paradas con más vehículos programados el último día del rango, de las dos redes.",
      "gridPos": {
        "h": 14,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE a.source WHEN 'emt_palma' THEN 'EMT' ELSE 'CTM' END AS \"Red\", a.entity AS \"Parada\", a.avg_value AS \"Pasos\" FROM gold.agg_daily_metrics a WHERE a.source IN ('emt_palma', 'ctm') AND a.metric = 'scheduled_departures' AND (a.source, a.local_date) IN (SELECT source, max(local_date) FROM gold.agg_daily_metrics WHERE source IN ('emt_palma', 'ctm') AND metric = 'scheduled_departures' AND local_date <= $__timeTo()::date GROUP BY source) ORDER BY a.avg_value DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pasos"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
