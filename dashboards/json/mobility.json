      "id": 1,
      "type": "stat",
      "title": "EMT Palma (último día)",
      "description": "Paradas con servicio y pasos de autobús programados el último día del rango.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT stops_with_service AS \"Paradas con servicio\", scheduled_stop_calls AS \"Pasos programados\" FROM gold.fct_bus_network_daily WHERE local_date <= $__timeTo()::date ORDER BY local_date DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2495C"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
