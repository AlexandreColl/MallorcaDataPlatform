    {
      "id": 3,
      "type": "timeseries",
      "title": "Pasos programados por día",
      "description": "Suma de los vehículos que pasan por cada parada cada día. Los fines de semana bajan; el cambio de horario de temporada de CTM se ve el 1 de noviembre.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT local_date::timestamptz AS time, 'EMT Palma' AS metric, scheduled_stop_calls AS value FROM gold.fct_bus_network_daily WHERE $__timeFilter(local_date::timestamptz) UNION ALL SELECT local_date::timestamptz, 'CTM', scheduled_stop_calls FROM gold.fct_island_transit_daily WHERE $__timeFilter(local_date::timestamptz) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
