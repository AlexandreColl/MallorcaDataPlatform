    {
      "id": 3,
      "type": "stat",
      "title": "Sospechosos",
      "description": "Porcentaje de valores marcados como sospechosos por las reglas de calidad o por la propia fuente.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
