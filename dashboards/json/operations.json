  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Fuentes",
        "description": "Una o varias fuentes: filtra indicadores, mapa, gráficas y tabla.",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "warehouse"
        },
        "query": "SELECT label AS __text, source AS __value FROM gold.dim_sources ORDER BY label",
        "definition": "SELECT label AS __text, source AS __value FROM gold.dim_sources ORDER BY label",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fuentes OK",
      "description": "Fuentes seleccionadas cuya última ejecución terminó bien.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT concat(count(*) FILTER (WHERE status = 'success'), ' / ', count(*)) AS \"Fuentes\" FROM (SELECT DISTINCT ON (source) source, status FROM ops.ingestion_runs WHERE source IN ($source) AND status <> 'running' ORDER BY source, started_at DESC) last_runs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Observaciones",
      "description": "Valores no ausentes de las fuentes seleccionadas en el rango de tiempo.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
