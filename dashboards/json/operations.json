  "tags": [
    "mallorca",
    "operacion"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "mallorca"
      ],
      "asDropdown": false,
      "title": "Dashboards",
      "includeVars": false,
      "keepTime": false,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Fuentes",
        "description": "Una o varias fuentes: filtra indicadores, mapa, gráficas y tabla.",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "warehouse"
        },
        "query": "SELECT label AS __text, source AS __value FROM gold.dim_sources ORDER BY label",
        "definition": "SELECT label AS __text, source AS __value FROM gold.dim_sources ORDER BY label",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 0
      },
      {
        "name": "serie",
        "label": "Serie corregida",
        "description": "Serie de estación (fuente/entidad/métrica) con correcciones, para el panel antes y después.",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "warehouse"
        },
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "sort": 1,
        "query": "SELECT DISTINCT concat(c.source, ' · ', coalesce(l.name, c.entity), ' · ', c.metric) AS __text, concat(c.source, '/', c.entity, '/', c.metric) AS __value FROM silver.corrections c LEFT JOIN gold.dim_locations l USING (source, entity) WHERE $__timeFilter(c.ts)",
        "definition": "SELECT DISTINCT concat(c.source, ' · ', coalesce(l.name, c.entity), ' · ', c.metric) AS __text, concat(c.source, '/', c.entity, '/', c.metric) AS __value FROM silver.corrections c LEFT JOIN gold.dim_locations l USING (source, entity) WHERE $__timeFilter(c.ts)"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Anomalías de la serie corregida",
        "enable": true,
        "iconColor": "#F2495C",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "warehouse"
        },
        "filter": {
          "exclude": false,
          "ids": [
            14
          ]
        },
        "target": {
          "refId": "Anno",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT min(ts) AS time, max(ts) + interval '1 hour' AS timeend, concat(coalesce(l.name, a.entity), ' · ', a.metric, ': ', count(DISTINCT ts), CASE WHEN count(DISTINCT ts) = 1 THEN ' valor anómalo' ELSE ' valores anómalos' END, ', de ', round(min(value)::numeric, 1), ' a ', round(max(value)::numeric, 1), ' (esperado ~', round(avg(expected)::numeric, 1), ')') AS text, string_agg(DISTINCT CASE detector WHEN 'robust_zscore' THEN 'z-score' ELSE 'isolation forest' END, ',') AS tags FROM (SELECT *, ts - dense_rank() OVER (PARTITION BY source, entity, metric ORDER BY ts) * interval '1 hour' AS run FROM silver.anomalies WHERE concat(source, '/', entity, '/', metric) = '$serie' AND $__timeFilter(ts)) AS a LEFT JOIN gold.dim_locations l USING (source, entity) GROUP BY source, a.entity, l.name, a.metric, run ORDER BY 1"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fuentes OK",
      "description": "Fuentes seleccionadas cuya última ejecución terminó bien.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT concat(count(*) FILTER (WHERE status = 'success'), ' / ', count(*)) AS \"Fuentes\" FROM (SELECT DISTINCT ON (source) source, status FROM ops.ingestion_runs WHERE source IN ($source) AND status <> 'running' ORDER BY source, started_at DESC) last_runs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
