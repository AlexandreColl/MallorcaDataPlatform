          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"Hora\", source AS \"Fuente\", coalesce(l.name, entity) AS \"Entidad\", metric AS \"Métrica\", detector AS \"Detector\", value AS \"Valor\", expected AS \"Esperado\", score AS \"Puntuación\" FROM silver.anomalies LEFT JOIN gold.dim_locations l USING (source, entity) WHERE source IN ($source) AND $__timeFilter(ts) ORDER BY ts DESC LIMIT 50"
