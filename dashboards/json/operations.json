          "rawQuery": true,
          "rawSql": "SELECT c.ts AS \"Hora\", c.source AS \"Fuente\", coalesce(l.name, c.entity) AS \"Entidad\", c.metric AS \"Métrica\", original_quality AS \"Original\", original_value AS \"Valor original\", corrected_value AS \"Corregido\", method AS \"Método\", concat_ws(' · ', c.support_source, coalesce(s.name, c.support_entity)) AS \"Apoyo\", bias AS \"Sesgo\", confidence AS \"Confianza\" FROM silver.corrections c LEFT JOIN gold.dim_locations l ON l.source = c.source AND l.entity = c.entity LEFT JOIN gold.dim_locations s ON s.source = c.support_source AND s.entity = c.support_entity WHERE c.source IN ($source) AND $__timeFilter(c.ts) ORDER BY c.ts DESC LIMIT 50"
