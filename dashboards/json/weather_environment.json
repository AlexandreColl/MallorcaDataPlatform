    {
      "id": 7,
      "type": "barchart",
      "title": "Calidad del aire: modelo frente a estaciones",
      "description": "dbt (fct_air_quality_model_bias_daily): media diaria del modelo CAMS de Open-Meteo menos la de cada estación oficial (EEA) en el punto del modelo más cercano, en el rango. Positivo: el modelo exagera. En Palma suele quedarse corto de NO2 junto al tráfico y pasarse de ozono, que el NO del tráfico consume.",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT station AS \"Estación\", avg(bias_ugm3) FILTER (WHERE metric = 'nitrogen_dioxide') AS \"NO2\", avg(bias_ugm3) FILTER (WHERE metric = 'ozone') AS \"O3\", avg(bias_ugm3) FILTER (WHERE metric = 'pm10') AS \"PM10\", avg(bias_ugm3) FILTER (WHERE metric = 'pm2_5') AS \"PM2.5\" FROM gold.fct_air_quality_model_bias_daily WHERE local_date BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY station ORDER BY station"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: µg/m³",
          "decimals": 1,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
