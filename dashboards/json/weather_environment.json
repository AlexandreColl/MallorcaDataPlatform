  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "$metric · media por fuente",
      "description": "Media horaria de la métrica en cada fuente seleccionada. Con temperatura o viento compara las estaciones reales de SOCIB con el modelo de Open-Meteo.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', o.ts) AS time, s.label AS metric, avg(o.value) AS value FROM gold.fct_observations o JOIN gold.dim_sources s USING (source) WHERE o.metric = '$metric' AND o.source IN ($source) AND $__timeFilter(o.ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
