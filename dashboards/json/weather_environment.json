    {
      "id": 5,
      "type": "barchart",
      "title": "Modelo vs estaciones: error de temperatura",
      "description": "dbt (fct_model_bias_daily): temperatura media diaria de Open-Meteo menos la medida por cada estación de AEMET y SOCIB en el punto del modelo más cercano, en el rango elegido. Sesgo positivo = el modelo calienta de más. Las 15 estaciones con más error; las de montaña de la Serra de Tramuntana delatan que el modelo no corrige la altitud.",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT concat(b.station, ' → ', b.model_point, ' (', round(b.distance_km::numeric, 1), ' km)') AS \"Estación\", avg(b.temperature_mean_bias) AS \"Sesgo medio\", avg(abs(b.temperature_mean_bias)) AS \"Error absoluto medio\" FROM gold.fct_model_bias_daily b WHERE (b.station_source IN ($source) OR 'open_meteo' IN ($source)) AND b.local_date BETWEEN $__timeFrom()::date AND $__timeTo()::date GROUP BY b.station, b.model_point, b.distance_km ORDER BY 3 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 2,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sesgo medio"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794F2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error absoluto medio"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              }
            ]
          }
        ]
      },
      "options": {
