    {
      "id": 6,
      "type": "table",
      "title": "Episodios meteorológicos",
      "description": "dbt (fct_weather_episodes): días seguidos con lluvia fuerte (≥ 30 mm en alguna estación), rachas ≥ 70 km/h u oleaje ≥ 2,5 m en cualquier punto de la isla, agrupados en episodios. Máximos de cada episodio y la estación con más lluvia; los 20 más recientes, sin depender del rango de tiempo.",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT concat(to_char(start_date, 'DD/MM/YY'), CASE WHEN end_date > start_date THEN to_char(end_date, ' – DD/MM') END) AS \"Fechas\", replace(replace(replace(episode_type, 'rain', 'lluvia'), 'wind', 'viento'), 'sea', 'mar') AS \"Tipo\", peak_rain_mm AS \"Lluvia (mm)\", peak_rain_station AS \"Estación\", max_stations_over_rain_threshold AS \"Est. ≥ 30 mm\", peak_gust_kmh AS \"Racha (km/h)\", peak_wave_m AS \"Ola (m)\" FROM gold.fct_weather_episodes ORDER BY start_date DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
