          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT make_date(extract(year FROM month)::int, 7, 1)::timestamp AS time, CASE metric WHEN 'nitrogen_dioxide' THEN 'NO2' WHEN 'ozone' THEN 'O3' WHEN 'pm10' THEN 'PM10' ELSE 'SO2' END AS metric, avg(mean_ugm3) AS value FROM gold.fct_air_quality_monthly WHERE metric IN ('nitrogen_dioxide', 'ozone', 'pm10', 'sulphur_dioxide') AND is_representative AND $__timeFilter(month::timestamp) GROUP BY 1, 2 ORDER BY 1"
