          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH y AS (SELECT extract(year FROM month)::int AS year, CASE WHEN count(international_tourists) FILTER (WHERE extract(month FROM month) BETWEEN 6 AND 9) = 4 THEN sum(international_tourists) FILTER (WHERE extract(month FROM month) BETWEEN 6 AND 9) END AS summer_tourists, max(reserves_pct) FILTER (WHERE extract(month FROM month) = 3) - max(reserves_pct) FILTER (WHERE extract(month FROM month) = 9) AS summer_drop, max(rain_hydrological_year_mm) FILTER (WHERE extract(month FROM month) = 8) AS rain_year FROM gold.fct_resources_monthly GROUP BY 1), totals AS (SELECT extract(year FROM month)::int AS year, CASE WHEN count(international_tourists) = 12 THEN sum(international_tourists) END AS tourists, CASE WHEN count(electricity_demand_gwh) = 12 THEN sum(electricity_demand_gwh) END AS demand, min(reserves_pct) AS reserves_min FROM gold.fct_resources_monthly GROUP BY 1) SELECT y.year::text AS \"Año\", t.tourists AS \"Turistas (año)\", y.summer_tourists AS \"Turistas jun-sep\", t.demand AS \"Demanda eléctrica (GWh)\", y.rain_year AS \"Lluvia año hidr. (mm)\", y.summer_drop AS \"Caída reservas mar-sep (pts)\", t.reserves_min AS \"Reservas mínimas (%)\" FROM y JOIN totals t USING (year) WHERE y.year >= 2017 ORDER BY y.year DESC"
        }
      ],
