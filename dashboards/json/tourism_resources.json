    {
      "id": 9,
      "type": "stat",
      "title": "Turistas de verano vs caída de reservas",
      "description": "Correlación de Pearson, año a año, entre los turistas de junio a septiembre y lo que bajan las reservas de marzo a septiembre (−1 a 1). Positiva: los veranos con más turistas son los que más bajan los acuíferos. Son pocos años y el turismo crece a lo largo de la década: es una correlación, no una causa.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH y AS (SELECT extract(year FROM month)::int AS year, CASE WHEN count(international_tourists) FILTER (WHERE extract(month FROM month) BETWEEN 6 AND 9) = 4 THEN sum(international_tourists) FILTER (WHERE extract(month FROM month) BETWEEN 6 AND 9) END AS summer_tourists, max(reserves_pct) FILTER (WHERE extract(month FROM month) = 3) - max(reserves_pct) FILTER (WHERE extract(month FROM month) = 9) AS summer_drop, max(rain_hydrological_year_mm) FILTER (WHERE extract(month FROM month) = 8) AS rain_year FROM gold.fct_resources_monthly GROUP BY 1) SELECT corr(summer_tourists, summer_drop) AS \"Correlación\", count(*) FILTER (WHERE summer_tourists IS NOT NULL AND summer_drop IS NOT NULL) AS \"Años\" FROM y"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Años"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
    {
