          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH y AS (SELECT extract(year FROM month)::int AS year, CASE WHEN count(international_tourists) FILTER (WHERE extract(month FROM month) BETWEEN 6 AND 9) = 4 THEN sum(international_tourists) FILTER (WHERE extract(month FROM month) BETWEEN 6 AND 9) END AS summer_tourists, max(reserves_pct) FILTER (WHERE extract(month FROM month) = 3) - max(reserves_pct) FILTER (WHERE extract(month FROM month) = 9) AS summer_drop, max(rain_hydrological_year_mm) FILTER (WHERE extract(month FROM month) = 8) AS rain_year FROM gold.fct_resources_monthly GROUP BY 1) SELECT corr(rain_year, summer_drop) AS \"Correlación\", count(*) FILTER (WHERE rain_year IS NOT NULL AND summer_drop IS NOT NULL) AS \"Años\" FROM y"
