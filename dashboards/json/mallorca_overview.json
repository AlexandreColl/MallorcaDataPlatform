    {
      "id": 8,
      "type": "geomap",
      "title": "Mapa de fuentes",
      "description": "Puntos: calidad del aire del modelo Open-Meteo (color según el índice europeo). Gotas: oleaje del modelo Open-Meteo Marine en 8 puntos de la costa (color y etiqueta según la altura de ola). Sol y nube: estaciones oficiales de AEMET con los valores del último día publicado (color según la temperatura media). Termómetros: estaciones reales de SOCIB con su última hora. Ondas: sismos del IGN en el rango (tamaño y color según la magnitud). Mancha de calor: vehículos programados por parada de EMT Palma y de la red de CTM (autobuses TIB, tren y metro) el último día del rango. REData no aparece: es el sistema eléctrico balear entero, no un punto. Cuadrados: estaciones oficiales de calidad del aire (EEA) con su última hora, coloreadas según la banda del índice europeo calculada con lo medido.",
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "warehouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (a.entity) a.entity AS localidad, l.lat, l.lon, a.european_aqi_model AS european_aqi, a.eaqi_label AS calidad, a.ts AS hora FROM gold.air_quality_hourly a JOIN gold.dim_locations l USING (source, entity) WHERE 'open_meteo' IN ($source) AND a.european_aqi_model IS NOT NULL AND a.ts <= $__timeTo() ORDER BY a.entity, a.ts DESC"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT entity, max(ts) AS ts FROM gold.fct_observations WHERE source = 'socib' AND ts <= $__timeTo() GROUP BY entity) SELECT o.entity AS estacion, l.lat, l.lon, max(o.value) FILTER (WHERE o.metric = 'temperature_2m') AS \"temperatura (°C)\", max(o.value) FILTER (WHERE o.metric = 'relative_humidity_2m') AS \"humedad (%)\", max(o.value) FILTER (WHERE o.metric = 'wind_speed_10m') AS \"viento (km/h)\", latest.ts AS hora FROM gold.fct_observations o JOIN latest ON latest.entity = o.entity AND latest.ts = o.ts JOIN gold.dim_locations l ON l.source = o.source AND l.entity = o.entity WHERE o.source = 'socib' AND 'socib' IN ($source) GROUP BY o.entity, l.lat, l.lon, latest.ts ORDER BY o.entity"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT event_id AS sismo, lat, lon, magnitude AS magnitud, depth_km AS \"profundidad (km)\", distance_to_palma_km AS \"distancia a Palma (km)\", ts AS hora FROM gold.fct_earthquakes WHERE 'ign' IN ($source) AND $__timeFilter(ts) ORDER BY magnitude"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT l.lat, l.lon, a.avg_value AS buses FROM gold.agg_daily_metrics a JOIN gold.dim_locations l USING (source, entity) WHERE a.source IN ($source) AND a.source IN ('emt_palma', 'ctm') AND a.metric = 'scheduled_departures' AND (a.source, a.local_date) IN (SELECT source, max(local_date) FROM gold.agg_daily_metrics WHERE source IN ('emt_palma', 'ctm') AND metric = 'scheduled_departures' AND local_date <= $__timeTo()::date GROUP BY source)"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT entity, max(ts) AS ts FROM gold.fct_observations WHERE source = 'open_meteo_marine' AND ts <= $__timeTo() GROUP BY entity) SELECT o.entity AS punto, l.lat, l.lon, max(o.value) FILTER (WHERE o.metric = 'wave_height') AS \"ola (m)\", max(o.value) FILTER (WHERE o.metric = 'wave_period') AS \"periodo (s)\", max(o.value) FILTER (WHERE o.metric = 'swell_wave_height') AS \"mar de fondo (m)\", max(o.value) FILTER (WHERE o.metric = 'sea_surface_temperature') AS \"temperatura del mar (°C)\", latest.ts AS hora FROM gold.fct_observations o JOIN latest ON latest.entity = o.entity AND latest.ts = o.ts JOIN gold.dim_locations l ON l.source = o.source AND l.entity = o.entity WHERE o.source = 'open_meteo_marine' AND 'open_meteo_marine' IN ($source) GROUP BY o.entity, l.lat, l.lon, latest.ts ORDER BY o.entity"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH last_day AS (SELECT max(local_date) AS d FROM gold.agg_daily_metrics WHERE source = 'aemet' AND local_date <= $__timeTo()::date) SELECT a.entity AS estacion, l.lat, l.lon, max(a.avg_value) FILTER (WHERE a.metric = 'temperature_2m_mean') AS \"temperatura media (°C)\", max(a.avg_value) FILTER (WHERE a.metric = 'temperature_2m_min') AS \"mínima (°C)\", max(a.avg_value) FILTER (WHERE a.metric = 'temperature_2m_max') AS \"máxima (°C)\", max(a.avg_value) FILTER (WHERE a.metric = 'precipitation_sum') AS \"lluvia (mm)\", max(a.avg_value) FILTER (WHERE a.metric = 'wind_gusts_10m_max') AS \"racha (km/h)\", a.local_date::text AS dia FROM gold.agg_daily_metrics a JOIN last_day ON a.local_date = last_day.d JOIN gold.dim_locations l USING (source, entity) WHERE a.source = 'aemet' AND 'aemet' IN ($source) GROUP BY a.entity, l.lat, l.lon, a.local_date ORDER BY a.entity"
        },
        {
          "refId": "G",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "warehouse"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT ON (a.entity) a.entity AS estacion_aire, l.lat, l.lon, a.eaqi_band AS banda_eaqi, a.eaqi_label AS calidad_estacion, a.no2 AS \"NO2 (ug/m3)\", a.o3 AS \"O3 (ug/m3)\", a.pm10 AS \"PM10 (ug/m3)\", a.ts AS hora FROM gold.air_quality_hourly a JOIN gold.dim_locations l USING (source, entity) WHERE a.source = 'eea_air_quality' AND 'eea_air_quality' IN ($source) AND a.eaqi_band IS NOT NULL AND a.ts <= $__timeTo() ORDER BY a.entity, a.ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "european_aqi"
            },
            "properties": [
