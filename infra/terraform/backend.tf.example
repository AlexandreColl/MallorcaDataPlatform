# Remote state for a real deployment: rename to backend.tf and run `terraform init -migrate-state`.
# The state bucket is created once by hand (it cannot hold the state that creates it). S3 locks the state natively
# with a lock file, so no DynamoDB table is needed.
terraform {
  backend "s3" {
    bucket       = "<your-terraform-state-bucket>"
    key          = "mallorca-data-platform/dev/terraform.tfstate"
    region       = "eu-south-2"
    encrypt      = true
    use_lockfile = true
  }
}
