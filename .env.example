# Copy to .env (`make init`). .env is git-ignored: never commit real secrets.
# Every value below is a local-only default.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
AIRFLOW_DB_PASSWORD=airflow
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=warehouse
WAREHOUSE_PASSWORD=warehouse
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=grafana_reader
API_DB_USER=api_reader
API_DB_PASSWORD=api_reader

# --- MinIO (S3-compatible) ----------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
BRONZE_BUCKET=bronze
SILVER_BUCKET=silver
# Least-privilege user with the policy of the AWS pipeline role (make minio-pipeline-user).
MINIO_PIPELINE_USER=mdp-pipeline
MINIO_PIPELINE_PASSWORD=mdp-pipeline-local

# --- Object store credentials (core/credentials.py) ---------------------------
# static (default): MinIO's root keys. role: assume S3_ROLE_ARN through STS with temporary credentials, renewed
# before they expire. default: the SDK's chain (ECS task role, EC2 instance profile...), no keys at all.
# To run the role flow locally, `make minio-pipeline-user` and uncomment (MinIO ignores the ARN and gives the
# session the user's policy):
# S3_CREDENTIALS=role
# S3_ACCESS_KEY=mdp-pipeline
# S3_SECRET_KEY=mdp-pipeline-local
# S3_ROLE_ARN=arn:aws:iam::000000000000:role/mdp-pipeline
# S3_STS_ENDPOINT_URL=http://minio:9000

# --- Airflow ------------------------------------------------------------------
# At least 64 bytes (HS512). Generate one with: openssl rand -hex 32
AIRFLOW_JWT_SECRET=local-dev-only-0123456789abcdef0123456789abcdef0123456789abcdef01
AIRFLOW_PORT=8080

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000

# --- REST API -----------------------------------------------------------------
API_PORT=8000
# Origins allowed to call the API from a browser (comma-separated); * = any (read-only public data).
API_CORS_ORIGINS=*

# --- Web front end ------------------------------------------------------------
WEB_PORT=3002

# --- Pipeline -----------------------------------------------------------------
# Retries of each ingest task when a source API fails (waits 2, 4, 8... minutes between tries).
MDP_TASK_RETRIES=3

# --- Lineage (optional) ------------------------------------------------------
# Uncomment the first two to start Marquez (UI at http://localhost:3001) and send the OpenLineage events of every DAG
# task and dbt model to it. Without them nothing is sent.
# COMPOSE_PROFILES=lineage
# OPENLINEAGE_URL=http://marquez:5000
# MARQUEZ_PORT=5000
# MARQUEZ_WEB_PORT=3001

# --- Connector secrets (only for connectors that declare them) ----------------
# OPENAQ_API_KEY=
# AQICN_TOKEN=
# Connector aemet: free key, requested by e-mail at https://opendata.aemet.es
# AEMET_API_KEY=

# --- Alert notifications (optional) -------------------------------------------
# Telegram bot that receives the Grafana alerts: create it with @BotFather, send it a message and read your chat id
# from https://api.telegram.org/bot<token>/getUpdates. Without both, alerts are only shown in Grafana.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
